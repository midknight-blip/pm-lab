  "id": "2589813",
  "question": "Will the Fed increase interest rates by 25 bps after the October 2026 meeting?",
  "conditionId": "0x12aa13b3da17ceae1b0a59b5d5b77121e91bb79b4bb0b52bf6543ed3f8d0953b",
